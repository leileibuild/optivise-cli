{
  "name": "@smart-planner/cli",
  "version": "1.0.2",
  "description": "Transparent optimization runs for AI agents",
  "type": "module",
  "bin": {
    "optivise": "dist/index.js",
    "smart-planner": "dist/index.js"
  },
  "files": [
    "dist",
    "skills/smart-planner-cli",
    "skills/optivise-cli"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/inject-packaged-backend.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test tests/*.test.js",
    "test:package": "node scripts/check-package.mjs",
    "test:skill": "node scripts/validate-skill.mjs",
    "test:journey": "node scripts/full-experience-gate.mjs",
    "test:smoke": "npm run build && node scripts/smoke-package.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leileibuild/optivise-cli.git"
  },
  "homepage": "https://github.com/leileibuild/optivise-cli#readme",
  "bugs": {
    "url": "https://github.com/leileibuild/optivise-cli/issues"
  },
  "license": "MIT"
}
